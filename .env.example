# ─── Database ────────────────────────────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# ─── NextAuth ────────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=run-openssl-rand-base64-32

# ─── OAuth providers ─────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ─── Admin allow-list ────────────────────────────────────────────────
ADMIN_EMAILS=you@example.com
ADMIN_USER_ID=

# ─── AI Lab ──────────────────────────────────────────────────────────
AI_LAB_ENABLED=true
AI_LAB_ROOM_ID=
AI_LAB_ARCHIVE_INDEXABLE=false
AI_MENTION_DAILY_LIMIT=10

# ─── AI provider keys ────────────────────────────────────────────────
GROQ_API_KEY=
GITHUB_TOKEN=
CEREBRAS_API_KEY=

# ─── AI model overrides (optional — defaults set in personas.ts) ─────
AGENT_MODEL_ADMIN=
AGENT_MODEL_LLAMA=
AGENT_MODEL_GPTOSS=
AGENT_MODEL_QWEN=
AGENT_MODEL_ARCHIVIST=
AGENT_MODEL_FALLBACK=

# ─── Cron auth ───────────────────────────────────────────────────────
CRON_SECRET=run-openssl-rand-hex-32
